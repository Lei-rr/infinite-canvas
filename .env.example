# 站点
PORT=3011
APP_TITLE=炸天帮画布

# 上游 OpenAI 兼容网关（文本 / 视频 / 音频等请求透传，以及对话式生图）
UPSTREAM_URL=http://your-new-api-host:3000
UPSTREAM_KEY=sk-your-api-key
# 上游不可用时展示的兜底模型列表（`/v1/models` 拉取失败时使用）
MODELS=gemini-3.1-flash-image,gemini-3.1-flash-image-2K,gemini-3.1-flash-image-4K,gpt-image-2
# 默认模型，留空时取默认渠道第一个模型
IMAGE_MODEL=

# l0veyou 渠道（网页登录态异步生图）。refresh token 只在首次初始化时生效，
# 之后 token 自动刷新并持久化到 ./data/auth/l0veyou.json
L0VEYOU_BASE_URL=https://l0veyou.com
L0VEYOU_REFRESH_TOKEN=rt-your-refresh-token
L0VEYOU_MODELS=gpt-image-2,gpt-image-2-5-flare,gpt-image-2-5-full

# 调度与超时（毫秒）
MAX_RETRIES=3
RETRY_DELAY_MS=1500
MAX_CONCURRENT=10
STAGGER_INTERVAL_MS=1000
MAX_BATCH=10
REQUEST_TIMEOUT_MS=90000
FORWARD_TIMEOUT_MS=600000
IMAGE_DOWNLOAD_TIMEOUT_MS=45000
MODEL_CACHE_MS=300000

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 统计分析（可选，默认关闭）
# ANALYTICS_GA4_ID=G-XXXXXXXXXX
# ANALYTICS_BAIDU_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
