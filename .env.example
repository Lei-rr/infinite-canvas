PORT=3011
APP_TITLE=炸天帮画布

# 上游服务地址与密钥
UPSTREAM_URL=http://your-new-api-host:3000
UPSTREAM_KEY=sk-your-api-key

# 生图模型名称
IMAGE_MODEL=gemini-3.1-flash-image

# 调度与超时参数 (适配 Cloudflare 100s 限制)
MAX_RETRIES=3
RETRY_DELAY_MS=1500
MAX_CONCURRENT=10
STAGGER_INTERVAL_MS=1200
REQUEST_TIMEOUT_MS=45000
IMAGE_DOWNLOAD_TIMEOUT_MS=45000
